# Environment Configuration (Template)
# Copy this file to .env and adjust credentials.

# Node environment: development, test, or production
NODE_ENV=development

# Server port
PORT=4000

# PostgreSQL Connection String (local or Neon serverless connection string)
DATABASE_URL=postgresql://mhanabdulsamad@localhost:5432/appointment_dev

# JWT Secret for signing session tokens (at least 32 characters)
JWT_SECRET=appointmo_super_secret_jwt_key_for_dev_only_32_chars

# Platform Admin Default Initial Password (change in production)
PLATFORM_ADMIN_PASSWORD=AppointmoAdmin2026!

# Allowed Web Client Origin
CORS_ORIGIN=http://localhost:5173

# Optional: Resend API Key for Email Notifications
RESEND_API_KEY=

# Optional: Gemini or LLM API Key (concierge fallback works deterministically without keys)
AI_API_KEY=

